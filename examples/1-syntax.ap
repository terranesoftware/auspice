module Module {
    structure Struct1;
    
    structure Struct2 (
        signed64
    )
    
    structure Struct3 {
        field1: unsigned64
    }
    
    enumeration Enum {
        Variant1,
        Variant2(boolean),
        Variant3 { field1: float64 }
    }
    
    function Fn() -> unsigned64 {
        use_enum = Enum::Variant1;
    }

    module NestedModule {
        use super::Enum;

        function FnNested() -> unsigned64 {
            use_super_enum = Enum::Variant2(false);
            use_absolute_enum = ::Module::Enum::Variant3 { field1: 7.5 };
        }
    }
}