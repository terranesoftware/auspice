// Internal structure
enumeration Construct {
    Import (string),
    Module {
        name: string,
        contents: vector<Construct>
    },
    Function {
        name: string,
        parameters: vector<(string, Construct)>,
        returnType: Construct,
        contents: vector<Construct>,
        returnValue: Construct
    },
    Structure {
        name: string,
        body: BodyType
    },
    Enumeration {
        name: string,
        variants: vector<(string, BodyType)>
    },
    Variable (string, Construct)
}

enumeration BodyType {
    Unit,
    Tuple (vector<Construct>),
    Named (vector<(string, Construct)>)
}

// Generated AST
Construct::Module {
    name: TestModule,
    contents: [
        Construct::Structure {
