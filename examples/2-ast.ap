// Internal structure
enumeration Construct {
    Module {
        name: string,
        contents: vector<Construct>
    },
    Function {
        name: string,
        parameters: vector<(string, Construct)>,
        returnType: Construct,
        contents: vector<Construct>
    },
    Structure {
        name: string,
        body: BodyType
    },
    Enumeration {
        name: string,
        variants: vector<(string, BodyType)>
    }
}

enumeration BodyType {
    Unit,
    Tuple (vector<Construct>),
    Named (vector<(string, Construct)>)
}

// Generated AST
Construct::Module {
    name: TestModule,
    contents: [
        Construct::Structure {
            name: Struct1,
            body: BodyType::Unit
        },
        Construct::Structure {
            name: Struct2,
            body: BodyType::Tuple(
                [
                    ?
                ]
            )
        },
        Construct::Structure {
            name: Struct3,
            body: BodyType::Named(
                [
                    (
                        field1,
                        ?
                    )
                ]
            )
        },
        Construct::Enumeration {
            name: Enum,
            variants: [
                (
                    variant1,
                    BodyType::Unit
                ),
                (
                    variant2,
                    BodyType::Tuple(
                        [
                            ?
                        ]
                    )
                )
            ]
        }
    ]
}