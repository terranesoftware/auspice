        },
        Construct::Structure {
            name: "Struct2",
            body: BodyType::Tuple(
                [
                    ?
                ]
            )
        },
        Construct::Structure {
            name: "Struct3",
            body: BodyType::Named (
                [
                    (
                        "field1",
                        ?
                    )
                ]
            )
        },
        Construct::Enumeration {
            name: "Enum",
            variants: [
                (
                    "variant1",
                    BodyType::Unit
                ),
                (
                    "variant2",
                    BodyType::Tuple (
                        [
                            ?
                        ]
                    )
                ),
                (
                    "variant3",
                    BodyType::Named (
                        [
                            (
                                "field1",
                                ?
                            )
                        ]
                    )
                )
            ]
        },
        Construct::Function {
            name: "Fn",
            parameters: [
                "param1",
                ?
            ],
            returnType: ?,
            contents: [
                Construct::Variable (
                    "use_enum",
                    ?
                )
            ],
            returnValue: ?
        },
        Construct::Module {
            name: "NestedModule",
            contents: [
                Construct::Import ("super::Enum"),
                Construct::Function {
                    name: "FnNested",
                    parameters: [],
                    returnType: ?,
                    contents: [
                        Construct::Variable (
                            "use_super_enum",
                            ?
                        ),
                        Construct::Variable (
                            "use_absolute_enum",
                            ?
                        )
                    ],
                    returnValue: ?
                }
            ]
        }
    ]
}