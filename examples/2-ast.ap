// Internal structure
enumeration Construct {
    Import (string),
    Module {
        name: string,
        contents: vector<Construct>
    },
    Function {
        name: string,
        parameters: vector<(string, Type)>,
        returnType: Type,
        contents: vector<Construct>,
        returnValue: Construct
    },
    Structure {
        name: string,
        body: BodyType
    },
    Enumeration {
        name: string,
        variants: vector<(string, BodyType)>
    },
    Variable (string, Construct)
}

enumeration BodyType {
    Unit,
    Tuple (vector<Type>),
    Named (vector<(string, Type)>)
}

// Generated AST
Construct::Module {
    name: "Module",
    contents: [
        Construct::Structure {
            name: "Struct1",
            body: BodyType::Unit
        },
        Construct::Structure {
            name: "Struct2",
            body: BodyType::Tuple ([signed64])
        },
        Construct::Structure {
            name: "Struct3",
            body: BodyType::Named ([("field1", unsigned64)])
        },
        Construct::Enumeration {
            name: "Enum",
            variants: [
                ("variant1", BodyType::Unit),
                ("variant2", BodyType::Tuple ([boolean])),
                ("variant3", BodyType::Named ([("field1", float64)]))
            ]
        },
        Construct::Function {
            name: "Fn",
            parameters: [("param1", vector<signed64>)],
            returnType: unsigned64,
            contents: [Construct::Variable ("use_enum", ::Module::Enum::variant1)],
            returnValue: ?
        },
        Construct::Module {
            name: "NestedModule",
            contents: [
                Construct::Import ("super::Enum"),
                Construct::Function {
                    name: "FnNested",
                    parameters: [],
                    returnType: unit,
                    contents: [
                        Construct::Variable ("use_super_enum", ::Module::Enum::variant2(false)),
                        Construct::Variable ("use_absolute_enum", ::Module::Enum::variant3 { field1: 7.5 })
                    ],
                    returnValue: ?
                }
            ]
        }
    ]
}